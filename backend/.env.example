# Copy to .env (never commit .env) or set these in your shell / IDE run configuration.
PARKIT_DB_URL=jdbc:postgresql://localhost:5432/parkit_db
PARKIT_DB_USERNAME=parkit_app
PARKIT_DB_PASSWORD=change-me
# Optional
PARKIT_SERVER_PORT=8080
PARKIT_DB_POOL_SIZE=10
# First ADMIN (created at start-up only if no ADMIN exists)
PARKIT_ADMIN_EMAIL=admin@example.com
PARKIT_ADMIN_PASSWORD=change-me-too
PARKIT_ADMIN_PHONE=9000000000
PARKIT_ADMIN_NAME=Administrator
